# =============================================================================
# REQUIRED — the BFF won't run the end-to-end demo flow without these.
# Fill these in first; everything below `OPTIONAL` has a sensible default.
# =============================================================================

# Huckleberry's HS256 cookie-signing secret. Generate with:
#   openssl rand -hex 32
# Rotating this invalidates every outstanding hb_session cookie.
SESSION_SIGNING_KEY=

# Public PKCE OAuth client registered on the target Domo instance via DCR.
# Register once via Postman's "2a. DCR — register public client (PKCE)" item
# from ~/dev/gatekeeper/docs/PostmanCollection.json. The DCR response gives
# you a client_id (here) and a registration_access_token (save separately
# for future RFC 7592 edits).
DOMO_OAUTH_CLIENT_ID=

# Comma-separated list of issuer URLs the BFF accepts tokens from. Each
# must match the literal `iss` claim Gatekeeper signs (scheme + host +
# port — no trailing slash).
GATEKEEPER_ISSUERS=https://your-instance.domo.com

# Stubbed instance-provisioning metadata used by POST /api/auth/signup.
# In dev the InstanceProvisioner is a stub that returns the values below
# (no real tenant is minted). Point at the Domo instance you want new
# signups to land on.
DEV_INSTANCE_ISSUER_URL=https://your-instance.domo.com
DEV_INSTANCE_CUSTOMER_ID=your-customer-id

# ── Database (choose one mode) ────────────────────────────────────────────────
#
# LOCAL DEV — docker-compose MySQL. Boot with `pnpm infra:up`.
# Leaving both DATABASE_URL and DATABASE_HOST unset falls back to in-memory
# repositories (fine for unit tests, no persistence across restarts).
DATABASE_URL=mysql://huckleberry:huckleberry@localhost:3306/huckleberry
# Apply Drizzle migrations at boot. Local dev only — production runs
# `pnpm db:migrate:prod` (deploy-time, GET_LOCK-gated) instead.
DATABASE_RUN_MIGRATIONS=true

# AURORA / PRODUCTION — set these instead of DATABASE_URL.
# The BFF authenticates via IAM database auth (no password stored).
# `pnpm db:migrate:prod` also uses these when DATABASE_URL is absent.
# DATABASE_HOST=<writer-endpoint>.cluster-xxx.us-east-1.rds.amazonaws.com
# DATABASE_PORT=3306
# DATABASE_USER=huckleberry_app
# DATABASE_NAME=huckleberry


# =============================================================================
# OPTIONAL — defaults work for local dev. Override per-need.
# =============================================================================

# Process / runtime
NODE_ENV=development
PORT=3000
VERBOSE_LOGGING=false
HUCKLEBERRY_AGENT_ID=huckleberry

# Domo tenant base URL — single-tenant DEV fallback for DomoAuthGuard and
# the proxy when no per-request issuer is known. In multi-tenant prod,
# GATEKEEPER_ISSUERS is the source of truth instead.
DOMO_INSTANCE_URL=https://your-instance.domo.com

# Domo developer token. Only consulted by the legacy DomoAuthGuard
# fallback in NODE_ENV=development. Leave blank to require a hb_session
# cookie for every Category A call.
DEV_TOKEN=

# Magic-link email landing URL — must be the SPA's host, not the BFF.
# The /auth/signin route is appended automatically.
MAGIC_LINK_BASE_URL=http://localhost:5173
MAGIC_LINK_TTL_SECONDS=900
SESSION_TTL_SECONDS=43200

# Operator admin API key. Required to hit POST /api/admin/users.
# Leave blank to disable the admin endpoints entirely.
ADMIN_API_KEY=

# Auth provider switch. `dev` keeps the legacy DomoAuthGuard; `gatekeeper`
# flips to the multi-tenant JWT verifier (Sprint 4+).
AUTH_PROVIDER=dev

# PKCE redirect_uri — must match what's registered on the DCR client.
DOMO_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/domo/callback
# Space-separated scope set requested at authorization time. Must be a
# subset of the scopes registered on the client.
DOMO_OAUTH_SCOPES="ai:read ai:execute content:meta:read content:data:read dataset:meta:read dataset:data:read identity:read search:read"
DEV_INSTANCE_SCOPES="ai:read ai:execute content:meta:read content:data:read dataset:meta:read dataset:data:read identity:read search:read"

# Per-issuer overrides — usually unneeded.
GATEKEEPER_ISSUER=
GATEKEEPER_JWKS_URI=
# CSV of `iss=uri` pairs when JWKS lives at a different host than the iss.
#   GATEKEEPER_JWKS_URIS=http://...:443=https://.../oauth2/jwks
GATEKEEPER_JWKS_URIS=
# CSV of `iss=base` pairs when the issuer string is identifier-only and
# the actual /oauth2/* endpoints live on a different scheme/host.
GATEKEEPER_TRANSPORT_URIS=
# Optional `aud` claim to enforce. Leave blank to skip.
GATEKEEPER_AUDIENCE=
# Real Gatekeeper-issued access token for the live integration spec.
# Auto-skips when unset. NEVER COMMIT.
GATEKEEPER_TEST_TOKEN=

# SMTP — local Mailpit container (web UI at http://localhost:8025) captures
# every outgoing magic-link email. Leave SMTP_HOST unset to fall back to
# ConsoleEmailService (logs the URL to the BFF console instead).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=huckleberry@localhost

# Neo4j (Ontology module — optional, not part of the auth or BFF demo)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
