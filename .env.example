# =============================================================================
# REQUIRED — fill these in first.
# =============================================================================

# HS256 cookie-signing secret. Generate with: openssl rand -hex 32
# Rotating this invalidates every outstanding hb_session cookie.
SESSION_SIGNING_KEY=

# Public PKCE OAuth client registered on the target Domo instance via DCR.
DOMO_OAUTH_CLIENT_ID=
DOMO_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/domo/callback
DOMO_OAUTH_SCOPES="ai:read ai:write ai:execute content:meta:read content:data:read dataset:meta:read dataset:data:read identity:read search:read"

# Issuer allowlist — must match the literal `iss` claim in the Gatekeeper JWT
# (scheme + host + port, no trailing slash).
GATEKEEPER_ISSUERS=https://your-instance.domo.com
DOMO_INSTANCE_URL=https://your-instance.domo.com

# Stubbed instance-provisioning metadata used by POST /api/auth/signup.
# In dev, InstanceProvisioner is a stub that returns these values — no real
# tenant is minted. Point at the Domo instance you want new signups to land on.
DEV_INSTANCE_ISSUER_URL=https://your-instance.domo.com
DEV_INSTANCE_CUSTOMER_ID=your-customer-id
DEV_INSTANCE_SCOPES="ai:read ai:write ai:execute content:meta:read content:data:read dataset:meta:read dataset:data:read identity:read search:read"

# Database — LOCAL DEV (docker-compose MySQL). Boot with `pnpm infra:up`.
# Leave both DATABASE_URL and DATABASE_HOST unset to fall back to in-memory
# repositories (no persistence across restarts).
DATABASE_URL=mysql://huckleberry:huckleberry@localhost:3306/huckleberry
DATABASE_RUN_MIGRATIONS=true

# AURORA / PRODUCTION — set these instead of DATABASE_URL.
# The BFF authenticates via IAM database auth (no password stored).
# DATABASE_HOST=<writer-endpoint>.cluster-xxx.us-east-1.rds.amazonaws.com
# DATABASE_PORT=3306
# DATABASE_USER=huckleberry_app
# DATABASE_NAME=huckleberry

# =============================================================================
# OPTIONAL — defaults work for local dev, set only if you need to override.
# =============================================================================

# Operator admin API key. Required to hit POST /api/admin/users.
# Leave blank to disable admin endpoints.
ADMIN_API_KEY=

# Magic-link email landing URL — must be the SPA's host, not the BFF.
MAGIC_LINK_BASE_URL=http://localhost:5173

# Email — pick one transport; SES takes priority over SMTP.
#
# SES (prod) — set SES_FROM to activate. Uses the AWS credential chain
# (IRSA on EKS, or AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY locally).
# SES_FROM=no-reply@yourdomain.com
# SES_REGION=us-east-1   # defaults to AWS_REGION if unset
#
# SMTP — Mailpit (http://localhost:8025) captures outgoing magic-link emails.
# Remove SMTP_HOST to fall back to ConsoleEmailService (logs URL to stdout).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=huckleberry@localhost

# Per-issuer overrides — only needed for non-standard Gatekeeper deployments.
# GATEKEEPER_JWKS_URIS=http://...:443=https://.../oauth2/jwks
# GATEKEEPER_TRANSPORT_URIS=http://host:443=https://host
# GATEKEEPER_AUDIENCE=

# Dev-only token bypass — never set in production (NODE_ENV=production disables it)
# DEV_TOKEN: the guard password; requests with x-domo-developer-token matching
# this value skip hb_session validation.
DEV_TOKEN=

# Allow self-signed TLS certs when targeting a local Domo instance with HTTPS.
# Set to '0' only if your dev Domo instance uses a self-signed cert.
# Never set in production.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Rate limiting (all optional — defaults shown)
# THROTTLE_GLOBAL_LIMIT=200
# THROTTLE_GLOBAL_TTL=60000
# THROTTLE_AUTH_EMAIL_LIMIT=3
# THROTTLE_AUTH_EMAIL_TTL=900000
# THROTTLE_AUTH_IP_LIMIT=10
# THROTTLE_AUTH_IP_TTL=60000
# THROTTLE_CONSUME_LIMIT=20
# THROTTLE_CONSUME_TTL=60000

# =============================================================================
# Token envelope encryption (Phase 6)
# =============================================================================

# KMS key ARN for production token encryption (AES-256-GCM, per-row DEK).
# Required in production. Leave unset for local dev — DEV_ENCRYPTION_KEY is used instead.
# KMS_KEY_ARN=arn:aws:kms:us-east-1:972900829293:key/<id>

# 32-byte hex key for local-dev token encryption (no KMS calls).
# Generate with: openssl rand -hex 32
# Required when DATABASE_URL is set and KMS_KEY_ARN is absent.
# If left blank, an ephemeral key is generated at boot (tokens won't survive restart).
DEV_ENCRYPTION_KEY=

# =============================================================================
# LocalStack KMS (optional — test KMS mode without a real AWS key)
# =============================================================================
# Default setup uses DEV_ENCRYPTION_KEY above. Only set these if you want to
# exercise the real KMS code path locally.
#
# Quick start:
#   pnpm infra:kms               # starts LocalStack + prints values below
#
# Teammates who don't need KMS testing can ignore this section entirely.
# No AWS credentials needed — the server uses dummy LocalStack creds automatically
# when KMS_ENDPOINT is set.
#
# KMS_ENDPOINT=http://localhost:4566
# KMS_KEY_ARN=arn:aws:kms:us-east-1:000000000000:key/<uuid-from-setup-script>
