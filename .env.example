# The Domo tenant hostname used in single-tenant DEV mode.
# In multi-tenant prod, GATEKEEPER_ISSUERS is the source of truth — this
# value is the dev fallback for `DomoAuthGuard` and the proxy base URL when
# no per-request issuer is known.
DOMO_INSTANCE_URL=https://your-instance.domo.com:443

DEV_TOKEN=your-developer-token
NODE_ENV=development
PORT=3000
VERBOSE_LOGGING=false
HUCKLEBERRY_AGENT_ID=huckleberry

# Huckleberry session — Layer A
# 256-bit HS256 signing key for the hb_session cookie. Generate with:
#   openssl rand -hex 32
# Rotate by generating a new value and restarting; outstanding sessions get
# silently invalidated (forces a fresh magic-link sign-in).
SESSION_SIGNING_KEY=

# Host prefix used in magic-link emails — must be the SPA's URL, not the BFF.
# The SPA's /auth/signin route handles the click, calls the BFF's consume
# endpoint via JS, and keeps the cookie same-origin via the dev proxy.
# Defaults to http://localhost:5173 (Vite dev server).
MAGIC_LINK_BASE_URL=http://localhost:5173

# Magic-link TTL in seconds. Default 900 (15 minutes).
MAGIC_LINK_TTL_SECONDS=900

# Huckleberry session TTL in seconds (sliding). Default 43200 (12h).
SESSION_TTL_SECONDS=43200

# Operator admin API key. Required to hit POST /admin/users (used to seed
# Layer A users during onboarding). Generate with: openssl rand -hex 32
# Leave blank in dev to disable the admin endpoints entirely.
ADMIN_API_KEY=

# Domo OAuth linkage — PKCE auth-code flow. The BFF is a PUBLIC OAuth
# client (no client_secret). On first sign-in for a `pending_link` user
# the SPA's AuthGuard redirects through Gatekeeper's /oauth2/authorize;
# the callback exchanges the code (with PKCE verifier) for a refresh
# token, which is then stored.
#
# Register a PKCE-only Gatekeeper client (token_endpoint_auth_method=none)
# whose redirect_uri matches DOMO_OAUTH_REDIRECT_URI exactly. See
# ~/dev/gatekeeper/docs/Endpoints.md §3 (DCR).
DOMO_OAUTH_CLIENT_ID=
DOMO_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/domo/callback
# Space-separated scope set requested at authorization time. Must be a
# subset of the scopes registered on the client. Quote it — multi-word
# values without quotes break naive shell .env sourcing.
DOMO_OAUTH_SCOPES="ai:read ai:execute content:meta:read content:data:read dataset:meta:read dataset:data:read identity:read search:read"

# Stubbed instance-provisioning metadata. POST /api/auth/signup calls
# the InstanceProvisioner to mint a Domo instance + user. In dev the
# provisioner is a stub that returns the existing dev instance below —
# no real tenant is created, and the BFF holds no Domo credentials
# (PKCE-only client; refresh token is minted per-user on first sign-in).
DEV_INSTANCE_ISSUER_URL=https://your-instance.domo.com
DEV_INSTANCE_CUSTOMER_ID=your-customer-id
DEV_INSTANCE_SCOPES="ai:read ai:execute content:meta:read content:data:read dataset:meta:read dataset:data:read identity:read search:read"

# Auth — Gatekeeper OAuth 2.1 (multi-tenant)
# AUTH_PROVIDER selects which guard runs. `dev` uses the legacy header-based
# DomoAuthGuard; `gatekeeper` uses the OAuth 2.1 multi-tenant JWT verifier.
AUTH_PROVIDER=dev

# Comma-separated list of issuer URLs we accept tokens from. Each must match
# the literal `iss` claim Gatekeeper signs (scheme, host, and port matter).
# When unset, falls back to GATEKEEPER_ISSUER, then DOMO_INSTANCE_URL.
# Example (multi-tenant prod):
#   GATEKEEPER_ISSUERS=https://cust1.domo.com,https://cust2.domo.com
# Example (dev against the labs instance):
#   GATEKEEPER_ISSUERS=http://domo-labs-dev.dev.domo.com:443
GATEKEEPER_ISSUERS=

# Legacy single-issuer override. Used only when GATEKEEPER_ISSUERS is empty.
GATEKEEPER_ISSUER=

# Per-issuer JWKS URI overrides. CSV of `iss=uri` pairs. Default per-issuer
# is `{iss}/oauth2/jwks`. Override only when the issuer string differs from
# the actual JWKS host (e.g., dev instances signing http:// issuers but
# exposing JWKS over https://).
# Example:
#   GATEKEEPER_JWKS_URIS=http://domo-labs-dev.dev.domo.com:443=https://domo-labs-dev.dev.domo.com/oauth2/jwks
GATEKEEPER_JWKS_URIS=

# Per-issuer transport base URL overrides. CSV of `iss=base` pairs. Used to
# rewrite the host of /oauth2/authorize, /oauth2/token, /oauth2/revoke when
# the issuer string is identifier-only and the actual endpoints live on a
# different scheme/host (e.g., iss=http://host:443 but transport is HTTPS).
# Example:
#   GATEKEEPER_TRANSPORT_URIS=http://domo-labs-dev.dev.domo.com:443=https://domo-labs-dev.dev.domo.com
GATEKEEPER_TRANSPORT_URIS=

# Legacy single-issuer JWKS override.
GATEKEEPER_JWKS_URI=

# Optional — leave blank to skip aud check. When set, must match the token's
# `aud` claim (Gatekeeper puts the client_id in `aud`).
GATEKEEPER_AUDIENCE=

# Optional — a real Gatekeeper-issued access token for the live integration
# spec at test/gatekeeper-auth.e2e-spec.ts. Get one via the Postman collection
# at ~/dev/gatekeeper/docs/PostmanCollection.json (items 2a → 4 → 5). Expires
# in ~1h. Leave blank to skip the live spec (it self-skips). NEVER COMMIT.
GATEKEEPER_TEST_TOKEN=

# Neo4j (Ontology module)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
