{
  "extensionsToTreatAsEsm": [".ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "useESM": true, "tsconfig": { "rootDir": "..", "module": "ESNext", "esModuleInterop": true, "emitDecoratorMetadata": true, "experimentalDecorators": true, "target": "ES2023", "skipLibCheck": true } }]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
