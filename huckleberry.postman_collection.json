              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "100" }
              ]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-domo-developer-token", "value": "{{devToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columns\": [\"*\"],\n  \"filters\": []\n}"
            },
            "description": "Query rows from a datasource."
          }
        }
      ]
    },
