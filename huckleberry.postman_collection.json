{
  "info": {
    "name": "Huckleberry Server",
    "description": "API collection for all Huckleberry Server endpoints.\n\nVariables:\n- `baseUrl`: e.g. http://localhost:3000\n- `devToken`: DEV_TOKEN value (DomoAuthGuard endpoints)\n- `hbSession`: hb_session cookie value (HuckleberryAuthGuard endpoints)\n- `csrfToken`: csrf_token cookie value\n- `adminApiKey`: ADMIN_API_KEY env value",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "devToken", "value": "" },
    { "key": "hbSession", "value": "" },
    { "key": "csrfToken", "value": "" },
    { "key": "adminApiKey", "value": "" },
    { "key": "agentId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "mcpServerId", "value": "" },
    { "key": "personaId", "value": "" },
    { "key": "datasourceId", "value": "" },
    { "key": "connectorDatabaseId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "groupId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health" },
            "description": "Health check — no auth required."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "HuckleberryAuthGuard. Public endpoints use no auth; protected endpoints require hb_session + csrf_token cookies.",
      "item": [
        {
          "name": "POST /api/auth/signup",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/signup" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "description": "Initiate signup flow. Returns 202 regardless of whether the email exists (existence-oracle protection)."
          }
        },
        {
          "name": "POST /api/auth/signin/request",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/signin/request" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "description": "Request a magic link for sign-in. Returns 202."
          }
        },
        {
          "name": "GET /api/auth/signin",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/signin?token=MAGIC_LINK_TOKEN",
              "query": [{ "key": "token", "value": "MAGIC_LINK_TOKEN" }]
            },
            "description": "Exchange magic-link token. Sets hb_session and csrf_token cookies."
          }
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout" },
            "header": [
              { "key": "Cookie", "value": "hb_session={{hbSession}}; csrf_token={{csrfToken}}" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "description": "Logout — clears cookies. Returns 204."
          }
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me" },
            "header": [
              { "key": "Cookie", "value": "hb_session={{hbSession}}; csrf_token={{csrfToken}}" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "description": "Returns the current user profile."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Requires x-admin-api-key header. Not under /api prefix.",
      "item": [
        {
          "name": "POST /admin/users",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/admin/users" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-admin-api-key", "value": "{{adminApiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"displayName\": \"New User\"\n}"
            },
            "description": "Provision a new user and Domo instance."
          }
        }
      ]
    },
    {
      "name": "Domo Linkage",
      "description": "HuckleberryAuthGuard. Links a Domo instance to the current user.",
      "item": [
        {
          "name": "POST /api/auth/domo/link/start",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/domo/link/start" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "hb_session={{hbSession}}; csrf_token={{csrfToken}}" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"issuerUrl\": \"https://your-instance.domo.com\"\n}"
            },
            "description": "Start PKCE OAuth flow. Returns { authorizeUrl }."
          }
        },
        {
          "name": "GET /api/auth/domo/callback",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/domo/callback?code=AUTH_CODE&state=STATE",
              "query": [
                { "key": "code", "value": "AUTH_CODE" },
                { "key": "state", "value": "STATE" }
              ]
            },
            "header": [
              { "key": "Cookie", "value": "hb_session={{hbSession}}; csrf_token={{csrfToken}}" }
            ],
            "description": "OAuth callback — exchanges code for tokens and redirects."
          }
        },
        {
          "name": "GET /api/auth/domo/links",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/domo/links" },
            "header": [
              { "key": "Cookie", "value": "hb_session={{hbSession}}; csrf_token={{csrfToken}}" }
            ],
            "description": "Returns active Domo link for the current user."
          }
        }
      ]
    },
    {
      "name": "Agents",
      "description": "DomoAuthGuard — pass x-domo-developer-token or x-domo-embedded-security header.",
      "item": [
        {
          "name": "GET /api/agents",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/agents" },
            "header": [{ "key": "x-domo-developer-token", "value": "{{devToken}}" }],
            "description": "List all available agents."
          }
        },
        {
          "name": "POST /api/agents",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/agents" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-domo-developer-token", "value": "{{devToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Agent\",\n  \"description\": \"A test agent\",\n  \"prompt\": \"You are a helpful assistant.\",\n  \"systemMessage\": null,\n  \"model\": null,\n  \"toolkitIds\": []\n}"
            },
            "description": "Create a new agent."
          }
        },
        {
          "name": "POST /api/agents/refresh",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/agents/refresh" },
            "header": [{ "key": "x-domo-developer-token", "value": "{{devToken}}" }],
            "description": "Refresh the agents list. Returns { count }."
          }
        },
        {
          "name": "POST /api/agents/search",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/agents/search" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-domo-developer-token", "value": "{{devToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 20,\n  \"offset\": 0,\n  \"filters\": [],\n  \"sortFieldMap\": {},\n  \"searchFieldMap\": {}\n}"
            },
            "description": "Search agents with optional filters and pagination."
          }
        },
        {
          "name": "GET /api/agents/:agentId",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}",
              "variable": [{ "key": "agentId", "value": "{{agentId}}" }]
            },
            "header": [{ "key": "x-domo-developer-token", "value": "{{devToken}}" }],
            "description": "Get a specific agent by ID."
          }
        },
        {
          "name": "PUT /api/agents/:agentId",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}",
              "variable": [{ "key": "agentId", "value": "{{agentId}}" }]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-domo-developer-token", "value": "{{devToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Agent Name\",\n  \"prompt\": \"Updated prompt.\"\n}"
            },
            "description": "Update an agent."
          }
        },
        {
          "name": "DELETE /api/agents/:agentId",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}",
              "variable": [{ "key": "agentId", "value": "{{agentId}}" }]
            },
            "header": [{ "key": "x-domo-developer-token", "value": "{{devToken}}" }],
            "description": "Delete an agent. Returns 204."
          }
        },
        {
          "name": "PATCH /api/agents/:agentId/context",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}/context",
              "variable": [{ "key": "agentId", "value": "{{agentId}}" }]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-domo-developer-token", "value": "{{devToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"add\": {\n    \"dataSourceIds\": [\"datasource-id-here\"],\n    \"cardIds\": [],\n    \"pageIds\": []\n  },\n  \"remove\": {\n    \"dataSourceIds\": [],\n    \"cardIds\": [],\n    \"pageIds\": []\n  }\n}"
            },
            "description": "Add or remove context items on an agent."
          }
        },
        {
          "name": "POST /api/agents/:agentId/execute/streaming",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}/execute/streaming",
              "variable": [{ "key": "agentId", "value": "{{agentId}}" }]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-domo-developer-token", "value": "{{devToken}}" },
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": \"What can you help me with?\",\n  \"sessionId\": null\n}"
            },
            "description": "Execute an agent and stream the response (SSE)."
          }
        },
        {
          "name": "POST /api/agents/:agentId/resume/streaming",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}/resume/streaming",
              "variable": [{ "key": "agentId", "value": "{{agentId}}" }]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-domo-developer-token", "value": "{{devToken}}" },
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"batchId\": null,\n  \"input\": \"yes\"\n}"
            },
            "description": "Resume a paused agent execution (user-in-the-loop). Streams response."
          }
        }
      ]
    },
    {
      "name": "Huckleberry",
      "description": "Direct huckleberry execution endpoints — DomoAuthGuard.",
      "item": [
        {
          "name": "POST /api/huckleberry/execute/streaming",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/huckleberry/execute/streaming" },
