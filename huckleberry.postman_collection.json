          "name": "GET /datasources",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/datasources?offset=0&limit=20",
              "query": [
                { "key": "offset", "value": "0" },
                { "key": "limit", "value": "20" },
                { "key": "nameLike", "value": "", "disabled": true }
              ]
            },
            "header": [{ "key": "x-domo-developer-token", "value": "{{devToken}}" }],
            "description": "List datasources with optional pagination and name filter."
