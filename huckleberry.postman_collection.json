            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"input\": \"yes\"\n}"
            },
            "description": "Resume a paused huckleberry execution."
          }
        }
      ]
    },
