            }
          }
        },
        {
          "name": "Update agent context",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}/context",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agents", "{{agentId}}", "context"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"dataSourceIds\": [\"ds-uuid-1\"],\n    \"cardIds\": [\"card-uuid-1\"],\n    \"filters\": []\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Execute agent (streaming SSE)",
          "request": {
            "method": "POST",
            "header": [
