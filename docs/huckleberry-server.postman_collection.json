{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Huckleberry Server",
    "description": "BFF for the Huckleberry AI platform.\n\n**Auth (dev):** Set the `devToken` variable to your `DEV_TOKEN` env value. The collection pre-request script injects `x-domo-developer-token` on every request — this bypasses session cookies and CSRF checks in non-production.\n\n**Auth (session):** For session-based flows, sign in via `POST /api/auth/signin/request`, follow the magic-link, then set the `hb_session` cookie and the `x-csrf-token` header (from the session response) on state-changing requests.\n\n**Variables to set:** `baseUrl`, `devToken`, `adminApiKey`, `agentId`, `sessionId`, `metricId`, `personaId`, `mcpServerId`, `datasourceId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "devToken", "value": "", "type": "string" },
    { "key": "adminApiKey", "value": "", "type": "string" },
    { "key": "agentId", "value": "", "type": "string" },
    { "key": "sessionId", "value": "", "type": "string" },
    { "key": "metricId", "value": "1", "type": "string" },
    { "key": "personaId", "value": "", "type": "string" },
    { "key": "mcpServerId", "value": "", "type": "string" },
    { "key": "datasourceId", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.collectionVariables.get('devToken');",
          "if (token) {",
          "  pm.request.headers.add({ key: 'x-domo-developer-token', value: token });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Magic-link authentication. signup, signin/request, and GET signin are @Public (no auth required).",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"path\": \"new\",\n  \"instanceUrl\": \"https://your-instance.domo.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Request sign-in (magic link)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/signin/request", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signin", "request"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Verify sign-in token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signin?token={{magicLinkToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signin"],
              "query": [{ "key": "token", "value": "{{magicLinkToken}}" }]
            }
          }
        },
        {
          "name": "Get current user (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Auth — Domo Linkage",
      "description": "OAuth2 PKCE flow to link a Domo instance to the user's Huckleberry account.",
      "item": [
        {
          "name": "Start Domo link",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/domo/link/start", "host": ["{{baseUrl}}"], "path": ["api", "auth", "domo", "link", "start"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"issuerUrl\": \"https://your-instance.domo.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "OAuth2 callback (browser redirect — not for direct invocation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/domo/callback?code=AUTH_CODE&state=STATE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "domo", "callback"],
              "query": [
                { "key": "code", "value": "AUTH_CODE" },
                { "key": "state", "value": "STATE" }
              ]
            }
          }
        },
        {
          "name": "Get active Domo links",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/domo/links", "host": ["{{baseUrl}}"], "path": ["api", "auth", "domo", "links"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Operator-only endpoints protected by x-admin-api-key header. @Public (no session required).",
