    {
      "name": "Metrics",
      "description": "Domo Metrics API proxy. All endpoints require HAS_AUTHORITY_AUTOMATED_INSIGHTS and the metrics feature switch on the Domo instance.",
      "item": [
        {
          "name": "List metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/metrics", "host": ["{{baseUrl}}"], "path": ["api", "metrics"] }
          }
        },
        {
          "name": "Create metric",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/metrics", "host": ["{{baseUrl}}"], "path": ["api", "metrics"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Total Revenue\",\n  \"description\": \"Sum of all revenue\",\n  \"datasourceId\": \"{{datasourceId}}\",\n  \"aggregation\": {\n    \"function\": \"SUM\",\n    \"value\": \"revenue\",\n    \"alias\": \"Total Revenue\"\n  },\n  \"preferredDateGrain\": \"MONTH\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Filter metrics",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/metrics/filter", "host": ["{{baseUrl}}"], "path": ["api", "metrics", "filter"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nameContains\": \"Revenue\",\n  \"limit\": 20,\n  \"offset\": 0,\n  \"orderBy\": \"CREATED_DESC\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Preview metric (unsaved dry-run)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/metrics/preview", "host": ["{{baseUrl}}"], "path": ["api", "metrics", "preview"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metric\": {\n    \"name\": \"Preview Metric\",\n    \"datasourceId\": \"{{datasourceId}}\",\n    \"aggregation\": { \"function\": \"COUNT\", \"value\": \"*\", \"alias\": \"Row Count\" }\n  },\n  \"sqlRequest\": {\n    \"dateGrain\": \"MONTH\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get metrics by datasource",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics/datasource/{{datasourceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics", "datasource", "{{datasourceId}}"]
            }
          }
        },
        {
          "name": "Get metric by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics/{{metricId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics", "{{metricId}}"]
            }
          }
        },
        {
          "name": "Update metric",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/metrics/{{metricId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics", "{{metricId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Metric Name\",\n  \"description\": \"Updated description\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete metric (soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics/{{metricId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics", "{{metricId}}"]
            }
          }
        },
        {
          "name": "Delete metric (hard)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics/{{metricId}}?hardDelete=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics", "{{metricId}}"],
              "query": [{ "key": "hardDelete", "value": "true" }]
            }
          }
        },
        {
          "name": "Get metric SQL",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/metrics/{{metricId}}/sql",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics", "{{metricId}}", "sql"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateGrain\": \"MONTH\",\n  \"calendarType\": \"STANDARD\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Execute metric",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/metrics/{{metricId}}/execute",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics", "{{metricId}}", "execute"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateGrain\": \"MONTH\",\n  \"dateRangeFilter\": {\n    \"startDate\": \"2025-01-01\",\n    \"endDate\": \"2025-12-31\",\n    \"column\": \"date\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Execute metric — period-over-period",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/metrics/{{metricId}}/execute/pop",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics", "{{metricId}}", "execute", "pop"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateGrain\": \"MONTH\",\n  \"periodDateRangeFilters\": {\n    \"current\": { \"startDate\": \"2025-01-01\", \"endDate\": \"2025-03-31\" },\n    \"previous\": { \"startDate\": \"2024-01-01\", \"endDate\": \"2024-03-31\" }\n  },\n  \"annotationDate\": false\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Datasources",
      "description": "Proxies the Domo DataSources API. Note: mounted outside the /api global prefix at /datasources.",
      "item": [
        {
          "name": "List datasources",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/datasources?offset=0&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["datasources"],
              "query": [
                { "key": "offset", "value": "0" },
                { "key": "limit", "value": "50" },
                { "key": "nameLike", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get datasource schema",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/datasources/{{datasourceId}}/schema",
              "host": ["{{baseUrl}}"],
              "path": ["datasources", "{{datasourceId}}", "schema"]
            }
          }
        },
        {
          "name": "Query datasource data",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/datasources/{{datasourceId}}/data?page=0&size=100",
              "host": ["{{baseUrl}}"],
              "path": ["datasources", "{{datasourceId}}", "data"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "100" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columns\": [\"date\", \"revenue\", \"region\"],\n  \"filters\": []\n}",
