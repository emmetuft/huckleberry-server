            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"input\": \"Yes, proceed with the analysis.\",\n  \"batchId\": \"\",\n  \"batchConfirmationId\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
