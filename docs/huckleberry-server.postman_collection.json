            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Agent\",\n  \"description\": \"An agent for data analysis\",\n  \"prompt\": \"You are a helpful data analysis assistant.\",\n  \"model\": \"claude-sonnet-4-6\",\n  \"toolkitIds\": []\n}",
